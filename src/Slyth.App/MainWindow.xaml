<Window x:Class="Slyth.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Slyth.App.ViewModels"
        xmlns:ui="clr-namespace:Slyth.App.Controls"
        xmlns:views="clr-namespace:Slyth.App.Views"
        Title="Slyth Optimizer" Icon="Assets/slyth.ico" Width="1320" Height="840" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Bg}" Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource TextFont}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid x:Name="Root">
        <!-- ======================= Conteúdo ======================= -->
        <Grid x:Name="Shell">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOverlayOpen}" Value="True">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <BlurEffect Radius="14" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ======== Barra lateral ======== -->
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel Margin="22,26,22,22">
                    <!-- Marca -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,40">
                        <Grid Width="38" Height="38">
                            <Border CornerRadius="11" Background="{StaticResource White}" />
                            <TextBlock Text="S" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="21"
                                       Foreground="{StaticResource Inverse}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2" />
                        </Grid>
                        <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                            <TextBlock ui:Spaced.Text="Slyth" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="16" />
                            <TextBlock ui:Spaced.Text="Optimizer" Style="{StaticResource Label}" FontSize="8.5" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Rodapé da barra lateral -->
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="16" CornerRadius="14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource White}" VerticalAlignment="Center" />
                                <TextBlock Margin="9,0,0,0" FontSize="12" FontWeight="SemiBold" Text="Modo administrador"
                                           Visibility="{Binding IsAdmin, Converter={StaticResource BoolVis}}" />
                                <TextBlock Margin="9,0,0,0" FontSize="12" FontWeight="SemiBold" Text="Sem administrador"
                                           Visibility="{Binding IsAdmin, Converter={StaticResource NotBoolVis}}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Body}" FontSize="11.5" Margin="16,4,0,0" Text="{Binding MachineSummary}" />
                            <TextBlock Style="{StaticResource Label}" Margin="16,10,0,0" Text="v1.0.0" />
                        </StackPanel>
                    </Border>

                    <!-- Navegação -->
                    <StackPanel>
                        <TextBlock ui:Spaced.Text="Menu" Style="{StaticResource Label}" Margin="4,0,0,12" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="Painel"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource Eq}, ConverterParameter=Dashboard}" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE945;"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource Eq}, ConverterParameter=Optimize}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Otimizações" />
                                <TextBlock Text="{Binding TotalCount}" Margin="8,0,0,0" Foreground="{StaticResource TextTertiary}" FontWeight="Normal" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE9D9;" Content="Desempenho"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource Eq}, ConverterParameter=Performance}" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE774;" Content="Rede"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource Eq}, ConverterParameter=Network}" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE823;"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource Eq}, ConverterParameter=Startup}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Inicialização" />
                                <TextBlock Text="{Binding Startup.EnabledCount}" Margin="8,0,0,0" Foreground="{StaticResource TextTertiary}" FontWeight="Normal" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE713;"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource Eq}, ConverterParameter=Bios}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="BIOS e hardware" />
                                <Border Background="{StaticResource White}" CornerRadius="8" MinWidth="16" Height="16" Padding="5,0" Margin="10,0,0,0"
                                        Visibility="{Binding BiosActionCount, Converter={StaticResource NonZeroVis}}">
                                    <TextBlock Text="{Binding BiosActionCount}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Inverse}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE81C;" Content="Histórico"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource Eq}, ConverterParameter=History}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ======== Páginas ======== -->
            <Grid Grid.Column="1">
                <views:DashboardView Style="{StaticResource Page}" Visibility="{Binding CurrentPage, Converter={StaticResource EqVis}, ConverterParameter=Dashboard}" />
                <views:OptimizeView Style="{StaticResource Page}" Visibility="{Binding CurrentPage, Converter={StaticResource EqVis}, ConverterParameter=Optimize}" />
                <views:PerformanceView Style="{StaticResource Page}" Visibility="{Binding CurrentPage, Converter={StaticResource EqVis}, ConverterParameter=Performance}" />
                <views:NetworkView Style="{StaticResource Page}" Visibility="{Binding CurrentPage, Converter={StaticResource EqVis}, ConverterParameter=Network}" />
                <views:StartupView Style="{StaticResource Page}" Visibility="{Binding CurrentPage, Converter={StaticResource EqVis}, ConverterParameter=Startup}" />
                <views:BiosView Style="{StaticResource Page}" Visibility="{Binding CurrentPage, Converter={StaticResource EqVis}, ConverterParameter=Bios}" />
                <views:HistoryView Style="{StaticResource Page}" Visibility="{Binding CurrentPage, Converter={StaticResource EqVis}, ConverterParameter=History}" />
            </Grid>
        </Grid>

        <!-- ======================= Botões da janela ======================= -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Panel.ZIndex="10">
            <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="Minimize_Click" />
            <Button x:Name="MaxButton" Style="{StaticResource ChromeButton}" Content="&#xE922;" Click="Maximize_Click" />
            <Button Style="{StaticResource ChromeCloseButton}" Content="&#xE8BB;" Click="Close_Click" />
        </StackPanel>

        <!-- ======================= Sobreposição: resultado ======================= -->
        <Grid Background="{StaticResource Scrim}" Visibility="{Binding IsResultOpen, Converter={StaticResource BoolVis}}" Panel.ZIndex="5">
            <Border Style="{StaticResource Card}" Width="520" MaxHeight="660" VerticalAlignment="Center" Padding="36,34" CornerRadius="26"
                    Background="{StaticResource HeroGlow}" BorderBrush="{StaticResource LineStrong}">
                <ContentControl Style="{StaticResource PopIn}" Focusable="False">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
                            <Grid Width="76" Height="76" HorizontalAlignment="Center">
                                <Ellipse Fill="{StaticResource Halo}" Width="150" Height="150" Margin="-37" />
                                <Ellipse Fill="{StaticResource White}" />
                                <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="30" Foreground="{StaticResource Inverse}" HorizontalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="Otimização concluída" Style="{StaticResource H1}" FontSize="26" HorizontalAlignment="Center" Margin="0,24,0,6" />
                            <TextBlock Style="{StaticResource Body}" TextAlignment="Center" Text="Backup salvo. Você pode desfazer tudo no Histórico." />
                            <TextBlock Style="{StaticResource Body}" TextAlignment="Center" Foreground="{StaticResource TextPrimary}" Margin="0,6,0,0"
                                       Text="Reinicie o PC: na próxima abertura o Slyth mede de novo e mostra o ganho real." />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom" Margin="0,24,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding RestartCommand}"
                                    Visibility="{Binding ResultRestart, Converter={StaticResource BoolVis}}" Margin="0,0,0,10">
                                <TextBlock Text="Reiniciar agora para concluir" />
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Content="Fechar" Command="{Binding CloseResultCommand}" Height="46" />
                        </StackPanel>

                        <!-- Números -->
                        <Grid DockPanel.Dock="Top" Margin="0,28,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding ResultApplied}" Style="{StaticResource BigNumber}" HorizontalAlignment="Center" />
                                <TextBlock ui:Spaced.Text="Aplicados" Style="{StaticResource Label}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{StaticResource Line}" />
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding ResultFreed}" Style="{StaticResource BigNumber}" HorizontalAlignment="Center" />
                                <TextBlock ui:Spaced.Text="Liberados" Style="{StaticResource Label}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <Border Grid.Column="3" Background="{StaticResource Line}" />
                            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding ResultFailed}" Style="{StaticResource BigNumber}" HorizontalAlignment="Center" />
                                <TextBlock ui:Spaced.Text="Falhas" Style="{StaticResource Label}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Lista detalhada -->
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1" Padding="0,8" Background="Transparent" CornerRadius="0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Results}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ResultRow}">
                                            <Grid Margin="0,7" Opacity="{Binding Opacity}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="11" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Body}" FontSize="11.5"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="200" Margin="12,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </ContentControl>
            </Border>
        </Grid>

        <!-- ======================= Sobreposição: confirmação ======================= -->
        <Grid Background="{StaticResource Scrim}" Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolVis}}" Panel.ZIndex="6">
            <Border Style="{StaticResource Card}" Width="440" VerticalAlignment="Center" Padding="32,30" CornerRadius="24" BorderBrush="{StaticResource LineStrong}">
                <ContentControl Style="{StaticResource PopIn}" Focusable="False">
                    <StackPanel>
                        <TextBlock Text="{Binding DialogTitle}" Style="{StaticResource H1}" FontSize="22" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DialogMessage}" Style="{StaticResource Body}" Margin="0,10,0,26" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource GhostButton}" Content="Cancelar" Height="46" Command="{Binding CancelDialogCommand}" />
                            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmDialogCommand}">
                                <TextBlock Text="{Binding DialogConfirm}" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </ContentControl>
            </Border>
        </Grid>
    </Grid>
</Window>
