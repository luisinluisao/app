<UserControl x:Class="Slyth.App.Views.BiosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Slyth.App.ViewModels"
             xmlns:ui="clr-namespace:Slyth.App.Controls">
    <Grid Margin="44,40,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,12,0">
            <TextBlock ui:Spaced.Text="BIOS e hardware" Style="{StaticResource Label}" />
            <TextBlock Text="Onde o Windows não alcança." Style="{StaticResource H1}" Margin="0,8,0,6" />
            <TextBlock Style="{StaticResource Body}" Text="O Slyth analisa seu hardware e mostra exatamente o que mudar na BIOS da sua placa-mãe, passo a passo." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,28,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Ficha técnica -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,0,36">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="24,20" CornerRadius="22">
                        <StackPanel>
                            <TextBlock ui:Spaced.Text="Seu hardware" Style="{StaticResource Label}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Hardware}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SpecRow}">
                                        <StackPanel>
                                            <Grid Margin="0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Body}" FontSize="12.5" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Right" />
                                            </Grid>
                                            <Border Style="{StaticResource Divider}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding RebootToBiosCommand}" Margin="0,22,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" Foreground="{StaticResource Inverse}" FontSize="13" Margin="0,0,10,0" />
                                    <TextBlock Text="Reiniciar direto na BIOS" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22,18" Background="Transparent" BorderBrush="{StaticResource LineStrong}">
                        <DockPanel>
                            <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" VerticalAlignment="Top" Margin="0,2,14,0" />
                            <TextBlock Style="{StaticResource Body}" FontSize="12.5"
                                       Text="O Slyth nunca altera a BIOS sozinho. Uma configuração errada pode impedir o PC de ligar e cada placa-mãe é diferente — por isso mostramos o caminho exato para você aplicar com segurança." />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Recomendações -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,12,36">
                <ItemsControl ItemsSource="{Binding BiosItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BiosItemViewModel}">
                            <Border x:Name="Card" Style="{StaticResource Card}" Margin="0,0,0,14" CornerRadius="22" Padding="26,22">
                                <StackPanel>
                                    <DockPanel>
                                        <Border x:Name="Status" DockPanel.Dock="Right" CornerRadius="8" Padding="10,4" BorderThickness="1"
                                                BorderBrush="{StaticResource LineStrong}" VerticalAlignment="Center">
                                            <TextBlock x:Name="StatusText" Text="{Binding StatusText, Converter={StaticResource Spaced}}" FontSize="9.5" FontWeight="Bold"
                                                       Foreground="{StaticResource TextSecondary}" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="OkGlyph" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,10,0" Visibility="Collapsed" />
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Explanation}" Style="{StaticResource Body}" Margin="0,10,0,0" />
                                    <ItemsControl ItemsSource="{Binding Steps}" Margin="0,16,0,0" Visibility="{Binding HasSteps, Converter={StaticResource BoolVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:StepRow}">
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="38" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="24" Height="24" CornerRadius="12" BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                                                            HorizontalAlignment="Left" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Number}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="13" TextWrapping="Wrap" LineHeight="19" Margin="0,2,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding NeedsAction}" Value="True">
                                    <Setter TargetName="Status" Property="Background" Value="{StaticResource White}" />
                                    <Setter TargetName="Status" Property="BorderBrush" Value="{StaticResource White}" />
                                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource Inverse}" />
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource LineStrong}" />
                                    <Setter TargetName="Card" Property="Background" Value="{StaticResource HeroGlow}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsOk}" Value="True">
                                    <Setter TargetName="OkGlyph" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Card" Property="Opacity" Value="0.7" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
