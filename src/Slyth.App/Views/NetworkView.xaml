<UserControl x:Class="Slyth.App.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Slyth.App.ViewModels"
             xmlns:ui="clr-namespace:Slyth.App.Controls">
    <UserControl.Resources>
        <Style x:Key="Metric" TargetType="TextBlock" BasedOn="{StaticResource BigNumber}">
            <Setter Property="FontSize" Value="46" />
        </Style>
        <Style x:Key="MetricUnit" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="6,0,0,10" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="44,40,32,0" DataContext="{Binding Network}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,12,0">
            <TextBlock ui:Spaced.Text="Rede" Style="{StaticResource Label}" />
            <TextBlock Text="Ping baixo. Conexão estável." Style="{StaticResource H1}" Margin="0,8,0,6" />
            <TextBlock Style="{StaticResource Body}" Text="Meça a qualidade real da sua conexão e descubra qual DNS responde mais rápido na sua casa." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,28,0,0" VerticalScrollBarVisibility="Auto" Padding="0,0,12,36">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Coluna esquerda -->
                <StackPanel>
                    <Border Style="{StaticResource Card}" Background="{StaticResource HeroGlow}" CornerRadius="24" Padding="30,26">
                        <StackPanel>
                            <TextBlock ui:Spaced.Text="Latência até a internet" Style="{StaticResource Label}" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Ping}" Style="{StaticResource Metric}" />
                                        <TextBlock Text="ms" Style="{StaticResource MetricUnit}" />
                                    </StackPanel>
                                    <TextBlock ui:Spaced.Text="Ping" Style="{StaticResource Label}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Jitter}" Style="{StaticResource Metric}" />
                                        <TextBlock Text="ms" Style="{StaticResource MetricUnit}" />
                                    </StackPanel>
                                    <TextBlock ui:Spaced.Text="Variação" Style="{StaticResource Label}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Loss}" Style="{StaticResource Metric}" />
                                        <TextBlock Text="%" Style="{StaticResource MetricUnit}" />
                                    </StackPanel>
                                    <TextBlock ui:Spaced.Text="Perda" Style="{StaticResource Label}" />
                                </StackPanel>
                            </Grid>
                            <ui:Sparkline Points="{Binding PingLine}" Height="70" Margin="0,22,0,0" />
                            <TextBlock Text="{Binding Verdict}" Style="{StaticResource Body}" Foreground="{StaticResource TextPrimary}" Margin="0,16,0,18" />
                            <Button Style="{StaticResource PrimaryButton}" Height="52" Command="{Binding TestCommand}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsTesting, Converter={StaticResource NotBoolVis}}">
                                        <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" Foreground="{StaticResource Inverse}" FontSize="14" Margin="0,0,12,0" />
                                        <TextBlock ui:Spaced.Text="Testar conexão" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock ui:Spaced.Text="Testando" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"
                                               Visibility="{Binding IsTesting, Converter={StaticResource BoolVis}}" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="24,14">
                        <StackPanel>
                            <TextBlock ui:Spaced.Text="Sua conexão" Style="{StaticResource Label}" Margin="0,6,0,4" />
                            <Grid Height="42">
                                <TextBlock Text="Adaptador" Style="{StaticResource Body}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding AdapterName}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="300" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" />
                            <Grid Height="42">
                                <TextBlock Text="Tipo" Style="{StaticResource Body}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding AdapterKind}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" />
                            <Grid Height="42">
                                <TextBlock Text="Velocidade do link" Style="{StaticResource Body}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LinkSpeed}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" />
                            <Grid Height="42">
                                <TextBlock Text="IP local" Style="{StaticResource Body}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LocalIp}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" />
                            <Grid Height="42">
                                <TextBlock Text="DNS atual" Style="{StaticResource Body}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CurrentDns}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Coluna direita: DNS -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" CornerRadius="24" Padding="26,22">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Voltar ao automático" Command="{Binding ResetDnsCommand}" FontSize="12" />
                                <TextBlock ui:Spaced.Text="Velocidade do DNS" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Body}" FontSize="12.5" Margin="0,10,0,8"
                                       Text="O DNS traduz o nome dos sites e servidores de jogo. Um DNS lento atrasa cada conexão nova." />
                            <ItemsControl ItemsSource="{Binding DnsRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DnsRowViewModel}">
                                        <StackPanel>
                                            <Grid Margin="0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                                        <Border Style="{StaticResource Pill}" Background="{StaticResource White}" BorderBrush="{StaticResource White}"
                                                                Visibility="{Binding IsFastest, Converter={StaticResource BoolVis}}">
                                                            <TextBlock ui:Spaced.Text="Mais rápido" Style="{StaticResource PillText}" Foreground="{StaticResource Inverse}" />
                                                        </Border>
                                                        <Border Style="{StaticResource Pill}" Visibility="{Binding IsCurrent, Converter={StaticResource BoolVis}}">
                                                            <TextBlock ui:Spaced.Text="Em uso" Style="{StaticResource PillText}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Servers}" Style="{StaticResource Body}" FontSize="11.5" FontFamily="{StaticResource MonoFont}" Margin="0,3,0,10" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="90" />
                                                        </Grid.ColumnDefinitions>
                                                        <ProgressBar Style="{StaticResource Meter}" Value="{Binding Score, Mode=OneWay}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding MsText}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Usar" Height="36" Margin="18,0,0,0" VerticalAlignment="Center"
                                                        Command="{Binding ApplyCommand}" Visibility="{Binding CanApply, Converter={StaticResource BoolVis}}" />
                                            </Grid>
                                            <Border Style="{StaticResource Divider}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="22,18" Background="Transparent" BorderBrush="{StaticResource LineStrong}">
                        <DockPanel>
                            <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" VerticalAlignment="Top" Margin="0,2,14,0" />
                            <TextBlock Style="{StaticResource Body}" FontSize="12.5"
                                       Text="Nenhum programa diminui o ping até o servidor do jogo — isso depende da distância e da operadora. O que dá para eliminar são os picos e as variações: cabo no lugar do Wi-Fi, placa de rede sem economia de energia, menos programas usando a internet e um DNS rápido." />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
