<UserControl x:Class="Slyth.App.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Slyth.App.ViewModels"
             xmlns:ui="clr-namespace:Slyth.App.Controls">
    <Grid Margin="44,40,32,0" DataContext="{Binding Performance}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,12,0">
            <TextBlock ui:Spaced.Text="Desempenho" Style="{StaticResource Label}" />
            <TextBlock Text="Antes e depois, em números." Style="{StaticResource H1}" Margin="0,8,0,6" />
            <TextBlock Style="{StaticResource Body}" Text="Medições reais do seu PC, feitas pelo próprio Windows. Sem números inventados: só conta como ganho o que passa da margem normal de variação." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,28,0,0" VerticalScrollBarVisibility="Auto" Padding="0,0,12,36">
            <StackPanel>
                <!-- Resultado -->
                <Border Style="{StaticResource Card}" Background="{StaticResource HeroGlow}" CornerRadius="24" Padding="32,28">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,28,0">
                            <TextBlock ui:Spaced.Text="Resultado" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding Headline}" Style="{StaticResource H1}" FontSize="30" TextWrapping="Wrap" Margin="0,10,0,8" />
                            <TextBlock Text="{Binding Subline}" Style="{StaticResource Body}" FontSize="13.5" />
                            <TextBlock Text="{Binding Dates}" Style="{StaticResource Label}" FontWeight="Normal" FontSize="11.5" Margin="0,14,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Width="250" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryButton}" Height="52" Command="{Binding MeasureCommand}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsMeasuring, Converter={StaticResource NotBoolVis}}">
                                        <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" Foreground="{StaticResource Inverse}" FontSize="14" Margin="0,0,12,0" />
                                        <TextBlock ui:Spaced.Text="Medir agora" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock ui:Spaced.Text="Medindo" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"
                                               Visibility="{Binding IsMeasuring, Converter={StaticResource BoolVis}}" />
                                </Grid>
                            </Button>
                            <StackPanel Margin="0,14,0,0" Visibility="{Binding IsMeasuring, Converter={StaticResource BoolVis}}">
                                <ProgressBar Style="{StaticResource Meter}" Maximum="1" Value="{Binding Progress, Mode=OneWay}" />
                                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Body}" FontSize="12" Margin="0,8,0,0" TextAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Label}" FontWeight="Normal" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"
                                       Text="Leva cerca de 20 segundos. Não use o PC enquanto mede."
                                       Visibility="{Binding IsMeasuring, Converter={StaticResource NotBoolVis}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Métricas -->
                <ItemsControl ItemsSource="{Binding Metrics}" Margin="-7,13,-7,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MetricRowViewModel}">
                            <Border x:Name="Card" Style="{StaticResource Card}" Margin="7" Padding="22,20" CornerRadius="20">
                                <StackPanel>
                                    <DockPanel>
                                        <Border x:Name="Pill" DockPanel.Dock="Right" CornerRadius="7" Padding="8,3" BorderThickness="1"
                                                BorderBrush="{StaticResource LineStrong}" VerticalAlignment="Center"
                                                Visibility="{Binding HasComparison, Converter={StaticResource BoolVis}}">
                                            <TextBlock x:Name="PillText" Text="{Binding Delta}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="{Binding Value}" Style="{StaticResource BigNumber}" />
                                        <TextBlock Text="{Binding Unit}" FontSize="14" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Bottom" Margin="6,0,0,7" />
                                    </StackPanel>
                                    <Grid Margin="0,14,0,0" Visibility="{Binding HasComparison, Converter={StaticResource BoolVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition Height="8" />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Antes" Style="{StaticResource Label}" FontWeight="Normal" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="1" Style="{StaticResource MeterDim}" Value="{Binding BeforeBar, Mode=OneWay}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Before}" FontSize="11.5" Foreground="{StaticResource TextTertiary}" Margin="10,0,0,0" MinWidth="34" TextAlignment="Right" />
                                        <TextBlock Grid.Row="2" Text="Agora" Style="{StaticResource Label}" FontWeight="Normal" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Row="2" Grid.Column="1" Style="{StaticResource Meter}" Value="{Binding AfterBar, Mode=OneWay}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Value}" FontSize="11.5" FontWeight="SemiBold" Margin="10,0,0,0" MinWidth="34" TextAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Body}" FontSize="11.5" LineHeight="16" Foreground="{StaticResource TextTertiary}" Margin="0,14,0,0" />
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsBetter}" Value="True">
                                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource White}" />
                                    <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource White}" />
                                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource Inverse}" />
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource LineStrong}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSame}" Value="True">
                                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource TextTertiary}" />
                                    <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource Line}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Como medir -->
                <Border Style="{StaticResource Card}" Margin="0,13,0,0" Padding="22,18" Background="Transparent" BorderBrush="{StaticResource LineStrong}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Usar a última medição como base" FontSize="12"
                                Command="{Binding ResetBaselineCommand}" VerticalAlignment="Center" Margin="20,0,0,0" />
                        <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" VerticalAlignment="Top" Margin="0,2,14,0" />
                        <TextBlock Style="{StaticResource Body}" FontSize="12.5"
                                   Text="Para comparar de forma justa, meça logo depois de ligar o PC e com os mesmos programas abertos. O Slyth mede sozinho na primeira vez e de novo depois que você otimiza e reinicia." />
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
