<UserControl x:Class="Slyth.App.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Slyth.App.ViewModels"
             xmlns:ui="clr-namespace:Slyth.App.Controls">
    <Grid Margin="44,40,32,0" DataContext="{Binding Startup}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,12,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock VerticalAlignment="Center" FontSize="13" Margin="0,0,20,0">
                    <Run Text="{Binding EnabledCount, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" de " Foreground="{StaticResource TextTertiary}" /><Run Text="{Binding Items.Count, Mode=OneWay}" Foreground="{StaticResource TextTertiary}" /><Run Text=" ligados" Foreground="{StaticResource TextTertiary}" />
                </TextBlock>
                <Button Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,10,0" />
                        <TextBlock Text="Atualizar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock ui:Spaced.Text="Inicialização" Style="{StaticResource Label}" />
                <TextBlock Text="O PC liga mais rápido." Style="{StaticResource H1}" Margin="0,8,0,6" />
                <TextBlock Style="{StaticResource Body}"
                           Text="Programas que abrem sozinhos com o Windows e ficam gastando memória e CPU escondidos. Desligar não desinstala nada: dá para religar a qualquer momento." />
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" Margin="0,28,0,0" VerticalScrollBarVisibility="Auto" Padding="0,0,12,36">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:StartupItemViewModel}">
                        <Border x:Name="Row" Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,8" CornerRadius="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="42" Height="42" Margin="0,0,18,0">
                                    <Border x:Name="Avatar" CornerRadius="12" Background="{StaticResource Elevated}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" />
                                    <TextBlock x:Name="AvatarText" Text="{Binding Initial}" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Body}" FontSize="12" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Publisher, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" /><Run Text="  ·  " Foreground="{StaticResource TextTertiary}" /><Run Text="{Binding Location, Mode=OneWay}" Foreground="{StaticResource TextTertiary}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Path}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource TextTertiary}"
                                               TextTrimming="CharacterEllipsis" Margin="0,4,0,0" ToolTip="{Binding Path}" />
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding IsEnabled}" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                <Setter TargetName="Avatar" Property="Background" Value="{StaticResource White}" />
                                <Setter TargetName="Avatar" Property="BorderBrush" Value="{StaticResource White}" />
                                <Setter TargetName="AvatarText" Property="Foreground" Value="{StaticResource Inverse}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                <Setter TargetName="Row" Property="Opacity" Value="0.6" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,80"
                    Visibility="{Binding Items.Count, Converter={StaticResource ZeroVis}}">
            <Grid Width="64" Height="64" HorizontalAlignment="Center">
                <Ellipse Stroke="{StaticResource LineStrong}" StrokeThickness="1" />
                <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="22" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
            </Grid>
            <TextBlock Text="Nada abre sozinho com o Windows" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,18,0,6" />
            <TextBlock Text="Sua inicialização já está limpa." Style="{StaticResource Body}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
