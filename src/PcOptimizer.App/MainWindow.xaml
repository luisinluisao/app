<Window x:Class="PcOptimizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PcOptimizer.App.ViewModels"
        Title="PC Optimizer" Width="1000" Height="720" MinWidth="760" MinHeight="560"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <CollectionViewSource x:Key="GroupedTweaks" Source="{Binding Tweaks}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Category" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <Grid Margin="24,18,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="PC Optimizer" FontSize="26" FontWeight="Bold" />
            <TextBlock Style="{StaticResource MutedText}" Text="Otimização segura em um clique, com backup automático de tudo o que for alterado." />
        </StackPanel>

        <TabControl Grid.Row="1" Margin="0,12,0,0">
            <!-- ============ OTIMIZAR ============ -->
            <TabItem Header="Otimizar">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                        <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedTweaks}}">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="2,8,0,6" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TweakItemViewModel}">
                                    <Border Style="{StaticResource CardBorderStyle}" Padding="14,12">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" />
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                                    <Border Style="{StaticResource Badge}" Background="#14532D" Visibility="{Binding IsApplied, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Aplicado" FontSize="11" Foreground="#86EFAC" />
                                                    </Border>
                                                    <Border Style="{StaticResource Badge}" Background="#1E3A5F" Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Requer reiniciar" FontSize="11" Foreground="#93C5FD" />
                                                    </Border>
                                                    <Border Style="{StaticResource Badge}" Background="#3F2A0B" Visibility="{Binding NotReversible, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Não reversível" FontSize="11" Foreground="#FCD34D" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding Description}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <DockPanel Grid.Column="1">
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <Button Style="{StaticResource PrimaryButton}" Content="⚡ Otimizar agora" Command="{Binding OptimizeCommand}" />
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0" TextAlignment="Center"
                                           Text="Cria um ponto de restauração e salva o estado atual antes de qualquer mudança." />
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,10,0,0" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                                <UniformGrid Columns="2" Margin="0,12,0,0">
                                    <Button Content="Recomendados" Command="{Binding SelectRecommendedCommand}" Margin="0,0,4,0" />
                                    <Button Content="Desfazer última" Command="{Binding UndoLastCommand}" Margin="4,0,0,0" />
                                </UniformGrid>
                                <Button Content="Reiniciar o PC" Command="{Binding RestartCommand}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Relatório" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Log}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource MutedText}" FontFamily="Consolas" FontSize="12" Margin="0,1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ============ BIOS ============ -->
            <TabItem Header="BIOS">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top" Margin="12,0,0,0">
                                    <Button Content="Reiniciar na BIOS" Command="{Binding RebootToBiosCommand}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Seu hardware" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding HardwareSummary}" LineHeight="20" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}" Background="#1F1A0E" BorderBrush="#3F2A0B">
                            <TextBlock TextWrapping="Wrap" Foreground="#FCD34D"
                                       Text="O PC Optimizer não altera a BIOS automaticamente: uma configuração errada pode impedir o PC de ligar. Aqui você vê o que vale a pena mudar e exatamente onde fica a opção na sua placa-mãe." />
                        </Border>
                        <ItemsControl ItemsSource="{Binding BiosItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BiosItemViewModel}">
                                    <Border Style="{StaticResource CardBorderStyle}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                                                <Border Style="{StaticResource Badge}" Background="{Binding StatusBrush}" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="#0F1115" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource MutedText}" Text="{Binding Explanation}" Margin="0,6,0,0" />
                                            <ItemsControl ItemsSource="{Binding Steps}" Margin="0,8,0,0" Visibility="{Binding HasSteps, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ HISTÓRICO ============ -->
            <TabItem Header="Histórico">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource MutedText}" Margin="0,0,0,10">
                        <Run Text="Cada otimização guarda os valores anteriores em" />
                        <Run Text="{Binding BackupFolder, Mode=OneWay}" Foreground="{StaticResource Text}" />
                    </TextBlock>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Backups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BackupItemViewModel}">
                                    <Border Style="{StaticResource CardBorderStyle}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Desfazer" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.RevertCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanRevert, Converter={StaticResource BoolToVis}}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding Detail}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <ProgressBar DockPanel.Dock="Right" Width="140" Height="4" IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Foreground="{StaticResource Accent}" Background="#262A33" BorderThickness="0" />
            <TextBlock Style="{StaticResource MutedText}" Text="{Binding Status}" />
        </DockPanel>
    </Grid>
</Window>
