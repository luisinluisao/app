<UserControl x:Class="Slyth.App.Views.OptimizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Slyth.App.ViewModels"
             xmlns:ui="clr-namespace:Slyth.App.Controls">
    <UserControl.Resources>
        <Style x:Key="TweakRow" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="22,16" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceHover}" />
                    <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="44,40,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,12,0">
            <StackPanel>
                <TextBlock ui:Spaced.Text="Otimizações" Style="{StaticResource Label}" />
                <TextBlock Style="{StaticResource H1}" Margin="0,8,0,6">
                    <Run Text="{Binding TotalCount, Mode=OneWay}" /><Run Text=" ajustes. Você escolhe." />
                </TextBlock>
                <TextBlock Style="{StaticResource Body}" Text="Todos reversíveis pelo Histórico, exceto limpezas (que não precisam ser desfeitas)." />
            </StackPanel>
        </Grid>

        <!-- Barra de ferramentas -->
        <Grid Grid.Row="1" Margin="0,26,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource SearchBox}" Tag="Buscar ajuste..." Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <ListBox Grid.Column="2" Style="{StaticResource Segmented}" ItemsSource="{Binding PresetOptions}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" />
            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" FontSize="13" Margin="0,0,18,0">
                    <Run Text="{Binding SelectedCount, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" selecionados" Foreground="{StaticResource TextTertiary}" />
                </TextBlock>
                <Button Style="{StaticResource LinkButton}" Content="Todos" Command="{Binding SelectAllCommand}" Margin="0,0,14,0" />
                <Button Style="{StaticResource LinkButton}" Content="Nenhum" Command="{Binding SelectNoneCommand}" Margin="0,0,20,0" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding OptimizeCommand}" MinWidth="150">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" Foreground="{StaticResource Inverse}" FontSize="13" Margin="0,0,10,0" />
                        <TextBlock Text="Aplicar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Categorias -->
        <ListBox Grid.Row="2" Style="{StaticResource ChipList}" Margin="0,18,12,14"
                 ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" />

        <!-- Lista -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,12,36">
            <ItemsControl ItemsSource="{Binding TweaksView}">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,22,0,12">
                                    <TextBlock Text="{Binding Name, Converter={StaticResource Spaced}}" Style="{StaticResource Label}" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock Text="{Binding ItemCount}" Style="{StaticResource Label}" Margin="10,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TweakItemViewModel}">
                        <Border Style="{StaticResource TweakRow}" MouseLeftButtonUp="Row_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource Pill}">
                                            <TextBlock Text="{Binding LevelName, Converter={StaticResource Spaced}}" Style="{StaticResource PillText}" />
                                        </Border>
                                        <Border Style="{StaticResource Pill}" Visibility="{Binding RequiresRestart, Converter={StaticResource BoolVis}}">
                                            <TextBlock ui:Spaced.Text="Reiniciar" Style="{StaticResource PillText}" />
                                        </Border>
                                        <Border Style="{StaticResource Pill}" Visibility="{Binding NotReversible, Converter={StaticResource BoolVis}}">
                                            <TextBlock ui:Spaced.Text="Permanente" Style="{StaticResource PillText}" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IsApplied, Converter={StaticResource BoolVis}}">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource White}" />
                                            <TextBlock Text="Ativo" FontSize="11.5" Margin="6,0,0,0" Foreground="{StaticResource TextSecondary}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" FontSize="12.5" Margin="0,5,0,0" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding IsSelected}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Estado vazio da busca -->
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,80"
                    Visibility="{Binding TweaksView.IsEmpty, Converter={StaticResource BoolVis}}">
            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="28" HorizontalAlignment="Center" Foreground="{StaticResource TextTertiary}" />
            <TextBlock Text="Nenhum ajuste encontrado" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,14,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
