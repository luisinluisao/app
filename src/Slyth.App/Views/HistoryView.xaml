<UserControl x:Class="Slyth.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Slyth.App.ViewModels"
             xmlns:ui="clr-namespace:Slyth.App.Controls">
    <Grid Margin="44,40,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,12,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding UndoLastCommand}" VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7A7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,10,0" />
                    <TextBlock Text="Desfazer a última" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock ui:Spaced.Text="Histórico" Style="{StaticResource Label}" />
                <TextBlock Text="Tudo pode voltar atrás." Style="{StaticResource H1}" Margin="0,8,0,6" />
                <TextBlock Style="{StaticResource Body}">
                    <Run Text="Antes de cada otimização o Slyth salva o estado anterior em" />
                    <Run Text="{Binding BackupFolder, Mode=OneWay}" Foreground="{StaticResource TextPrimary}" />
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <!-- Linha do tempo -->
        <ScrollViewer Grid.Row="1" Margin="0,34,0,0" VerticalScrollBarVisibility="Auto" Padding="0,0,12,36">
            <ItemsControl ItemsSource="{Binding Backups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BackupItemViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="1" Background="{StaticResource Line}" HorizontalAlignment="Center" />
                            <Ellipse x:Name="Dot" Width="11" Height="11" Fill="{StaticResource White}" Stroke="{StaticResource White}" StrokeThickness="1.5"
                                     VerticalAlignment="Top" Margin="0,30,0,0" />
                            <Border x:Name="Card" Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,14" Padding="24,20">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Desfazer" VerticalAlignment="Center"
                                            Command="{Binding DataContext.RevertCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                            Visibility="{Binding CanRevert, Converter={StaticResource BoolVis}}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Date}" Style="{StaticResource H2}" />
                                        <TextBlock Margin="0,6,0,0" FontSize="13">
                                            <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="  ·  " Foreground="{StaticResource TextTertiary}" /><Run Text="{Binding Detail, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding CanRevert}" Value="False">
                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Bg}" />
                                <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource LineStrong}" />
                                <Setter TargetName="Card" Property="Opacity" Value="0.55" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Vazio -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,80"
                    Visibility="{Binding Backups.Count, Converter={StaticResource ZeroVis}}">
            <Grid Width="64" Height="64" HorizontalAlignment="Center">
                <Ellipse Stroke="{StaticResource LineStrong}" StrokeThickness="1" />
                <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="22" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
            </Grid>
            <TextBlock Text="Nenhuma otimização ainda" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,18,0,6" />
            <TextBlock Text="Quando você otimizar, cada execução aparece aqui." Style="{StaticResource Body}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
